// ClientBilling invoice MVP. Level B: we own invoice UX; Quantum/CDG owns Pay.
// Never store cardholder data. Never act as merchant of record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvoiceStatus {
  draft
  sent
  viewed
  paid
  void
  overdue
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business BusinessProfile?
  clients  Client[]
  invoices Invoice[]
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Password reset tokens (decision 0006). identifier = email, token = sha256 of the raw token.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BusinessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  email     String
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  postalCode String?
  country   String   @default("US")
  logoUrl   String?
  nextInvoiceNumber Int @default(1001)

  /// Shown to payers in the Pay section of the public invoice (decision 0008).
  paymentInstructions String? @db.Text

  // Quantum connection fields are unused until decision 0002 is revisited.
  // Never store gateway passwords or RestrictKeys.
  quantumConnected     Boolean @default(false)
  quantumMerchantLabel String?
  quantumGwLoginRef    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  address1  String?
  city      String?
  state     String?
  postalCode String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
}

model Invoice {
  id             String        @id @default(cuid())
  publicId       String        @unique
  userId         String
  clientId       String
  number         String
  status         InvoiceStatus @default(draft)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  currency       String        @default("USD")
  notes          String?       @db.Text
  taxRateBps     Int           @default(0) // basis points, e.g. 825 = 8.25%
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lineItems InvoiceLineItem[]
  events    InvoiceEvent[]

  @@unique([userId, number])
  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 4)
  unitPriceCents Int
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  type      String
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// First-party product events (decision 0007). No cookies, no fingerprinting.
model Event {
  id        String   @id @default(cuid())
  name      String
  path      String?
  userId    String?
  payload   String?  @db.Text
  country   String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}

/// Fixed-window counters for rate limiting auth and email actions (decisions 0004, 0006).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
