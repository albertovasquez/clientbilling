// ClientBilling invoice MVP. Level B: we own invoice UX; Quantum/CDG owns Pay.
// Never store cardholder data. Never act as merchant of record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecurringCadence {
  weekly
  monthly
  quarterly
  yearly
}

enum InvoiceStatus {
  draft
  sent
  viewed
  paid
  void
  overdue
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  sessionVersion Int    @default(0) // bumped on password reset; tokens issued earlier are refused (decision 0020)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business BusinessProfile?
  clients  Client[]
  invoices Invoice[]
  accounts Account[]
  sessions Session[]
  apiKeys  ApiKey[]
  schedules RecurringSchedule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Password reset tokens (decision 0006). identifier = email, token = sha256 of the raw token.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BusinessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  email     String
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  postalCode String?
  country   String   @default("US")
  logoUrl   String?
  nextInvoiceNumber Int @default(1001)

  /// Shown to payers in the Pay section of the public invoice (decision 0008).
  paymentInstructions String? @db.Text

  /// Merchant-provided hosted payment page, shown as Pay online (decision 0014). https only.
  payLinkUrl String?

  /// Prefill for new invoices and recurring schedules.
  defaultDueInDays Int @default(14)
  defaultTaxRateBps Int @default(0)
  defaultNotes String? @db.Text

  // Quantum connection fields are unused until decision 0002 is revisited.
  // Never store gateway passwords or RestrictKeys.
  quantumConnected     Boolean @default(false)
  quantumMerchantLabel String?
  quantumGwLoginRef    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  address1  String?
  city      String?
  state     String?
  postalCode String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  schedules RecurringSchedule[]

  @@index([userId])
}

model Invoice {
  id             String        @id @default(cuid())
  publicId       String        @unique
  userId         String
  clientId       String
  number         String
  status         InvoiceStatus @default(draft)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  currency       String        @default("USD")
  notes          String?       @db.Text
  taxRateBps     Int           @default(0) // basis points, e.g. 825 = 8.25%
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  /// Required when status is void; kept for audit (roadmap credit notes / voids with reason).
  voidReason     String?
  recurringScheduleId String?
  paidCents      Int           @default(0) // sum of Payment.amountCents, kept in step by the payments service
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  schedule  RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  events    InvoiceEvent[]
  payments  Payment[]

  @@unique([userId, number])
  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([recurringScheduleId])
}

/// Recurring invoice schedules (decision 0018). linesJson holds NewLine[] as JSON.
model RecurringSchedule {
  id         String            @id @default(cuid())
  userId     String
  clientId   String
  cadence    RecurringCadence  @default(monthly)
  nextRunAt  DateTime
  dueInDays  Int               @default(14)
  taxRateBps Int               @default(0)
  notes      String?           @db.Text
  linesJson  String            @db.Text
  autoSend   Boolean           @default(false)
  active     Boolean           @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([userId])
  @@index([active, nextRunAt])
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 4)
  unitPriceCents Int
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  type      String
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// First-party product events (decision 0007). No cookies, no fingerprinting.
model Event {
  id        String   @id @default(cuid())
  name      String
  path      String?
  userId    String?
  payload   String?  @db.Text
  country   String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
}

/// Personal API keys (decision 0017). Raw key shown once; only the SHA-256 is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fixed-window counters for rate limiting auth and email actions (decisions 0004, 0006).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

enum PaymentMethod {
  cash
  check
  bank_transfer
  card
  other
}

/// A payment received against an invoice (decision 0019). Recorded by the
/// merchant; ClientBilling never moves money. Amounts are integer cents.
model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  userId      String
  amountCents Int
  method      PaymentMethod @default(other)
  paidOn      DateTime
  note        String?
  source      String        @default("app")
  createdAt   DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId, paidOn])
}
