# "Start a CDG application": CDG Commerce secure merchant application (agent 470).
NEXT_PUBLIC_AFFILIATE_SIGNUP_URL=https://secure.cdgcommerce.com/onlineapp/onlineapp-ht-newV2.php?agentid=470&appcode=CLIENTBILLING&utm_source=clientbilling&utm_medium=cta&utm_campaign=site

# "Get a free quote from CDG": CDG Commerce quote form (agent 470).
NEXT_PUBLIC_CDG_QUOTE_URL=https://www.cdgcommerce.com/applynow/?R=470&utm_source=clientbilling&utm_medium=cta&utm_campaign=quote

# Postgres for the invoice app (Neon, us-east-1). Required for /app and /i/*.
# DATABASE_URL is the pooled connection string (host contains "-pooler").
# DIRECT_URL is the direct connection string, used only by migrations.
DATABASE_URL=
DIRECT_URL=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical site URL for Auth.js callbacks (local: http://localhost:3000)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Transactional email through Resend. Both are required together; without them
# the app offers copy link only.
RESEND_API_KEY=
RESEND_FROM=

# Online card payment UI beyond the CDG links. Leave unset until CDG confirms
# the integration in writing (docs/decisions/0002).
COLLECT_ONLINE=

# Comma-separated emails allowed to view /app/admin/funnel.
ADMIN_EMAILS=

# Bearer token Vercel Cron sends to /api/cron/overdue. Generate with: openssl rand -hex 32
CRON_SECRET=
