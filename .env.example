# "Start a CDG application": CDG Commerce secure merchant application (agent 470).
NEXT_PUBLIC_AFFILIATE_SIGNUP_URL=https://secure.cdgcommerce.com/onlineapp/onlineapp-ht-newV2.php?agentid=470&appcode=CLIENTBILLING&utm_source=clientbilling&utm_medium=cta&utm_campaign=site

# "Get a free quote from CDG": CDG Commerce quote form (agent 470).
NEXT_PUBLIC_CDG_QUOTE_URL=https://www.cdgcommerce.com/applynow/?R=470&utm_source=clientbilling&utm_medium=cta&utm_campaign=quote

# Postgres for the invoice app (Neon recommended). Required for /app and /i/*.
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Auth.js / NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional alias used by some tooling:
NEXTAUTH_SECRET=
# Canonical site URL for Auth.js callbacks (local: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Optional: send invoice emails via Resend. Without it, share/copy link still works.
RESEND_API_KEY=
# Optional verified sender, e.g. ClientBilling <invoices@clientbilling.com>
RESEND_FROM=
